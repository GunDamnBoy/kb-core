<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.kenny.podfetch</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/macmini/.venvs/kb/bin/python</string>
    <string>/Users/macmini/kb-core/scripts/podcast/podfetch.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/macmini</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <!-- 前兩個目錄現在是空的（ffmpeg 未裝）。留著是因為裝了就會自動生效，
         而 watch.external_binaries 會在裝好之前一直用 WARN 提醒。 -->
    <key>HOME</key>
    <string>/Users/macmini</string>
  </dict>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>1</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/macmini/.podfetch/podfetch.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/macmini/.podfetch/podfetch.log</string>
</dict>
</plist>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- 2026-08-21 新增。日報 03:00 產草稿、publish 在一分鐘內接手，
       04:00 這一輪只做「把已發布的 JSON 排版成 Word」。

       為什麼是獨立一支而不是掛在 kbwatch.podcast 上：
       **看門狗的依賴要比它守的東西少。** 轉檔要寫 ~/Documents、要 python-docx，
       掛上去就是給看門狗兩個新的失敗點，而那兩個之中任何一個壞掉
       都會讓看門狗自己變紅、把真正的訊號埋掉。

       為什麼不是 StartInterval：這件事一天只該產出一次，而且要落在日報之後。
       釘整點才不會隨載入時刻漂進 03:00 的日報中間。

       **為什麼是四個時刻而不是一個（2026-08-24 增修）**：
       原本只釘 04:00，而它讀的回執是「那一刻」的狀態，不是那一天的結局 ——
       回執每輪都會被覆寫，發布晚成功時它會從非 0 翻成 0。08-24 那天 publish
       卡在 rebase，04:00 依規則拒絕轉檔（正確），06:43 人工修好、回執翻成 0，
       **而本支當天不會再跑**，於是網站有、Word 沒有，是人工補的。
       「一天只跑一次」被當成了「一天只問一次」，而那是兩件事。
       腳本第 46 行的冪等守衛（日檔沒比 Word 新就跳過）讓多問幾次幾乎免費：
       已經產出的那天，後面三輪各是一次 stat 比較就 exit 0。
       04／07／10／13 覆蓋到早班人力能介入的範圍；再晚就該由人處理，
       不是讓排程無限問下去 —— **重試不是修復，只是把修復的期限往後挪。**

       退出碼 13（EMPTY_ROUND）是設計上的正常 —— 沒有回執、或回執非 0 的那一輪
       本來就不該有 Word。**別拿 launchctl list 判死活。** -->
  <key>Label</key>
  <string>com.kenny.kbdocx.podcast</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/macmini/kb-core/launchd/kbdocx-podcast.sh</string>
  </array>

  <!-- PATH 與 HOME 明寫在這裡，即使包裝腳本自己也 export 一次。
       **檢查讀的是 plist，不是腳本** —— 而 launchd 的預設環境只有
       /usr/bin:/bin:/usr/sbin:/sbin，兩者不一致時安靜的那一邊會贏。
       2026-08-21 watch.external_binaries 就是這樣抓到這兩支的。 -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>/Users/macmini</string>
  </dict>

  <key>WorkingDirectory</key>
  <string>/Users/macmini</string>

  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>4</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>0</integer></dict>
  </array>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/macmini/outbox/podcast/docx.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/macmini/outbox/podcast/docx.log</string>
</dict>
</plist>
